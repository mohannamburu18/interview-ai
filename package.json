{
  "name": "interview-ai-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Interview AI — Real-Time Technical Interview Co-Pilot with Zero Hallucinations and Instant Polyglot Code Switching",
  "scripts": {
    "dev": "npm --prefix website run dev",
    "build": "npm --prefix website run build",
    "start": "npm --prefix website run start",
    "dev:web": "npm --prefix website run dev",
    "dev:electron": "npm --prefix desktop run dev",
    "electron:dev": "npm --prefix desktop run dev",
    "build:web": "npm --prefix website run build",
    "build:electron": "npm --prefix desktop run build",
    "package:win": "npm --prefix desktop run build:win",
    "package:mac": "npm --prefix desktop run build:mac",
    "package:linux": "npm --prefix desktop run build:linux",
    "install:all": "npm install && npm --prefix website install && npm --prefix desktop install"
  },
  "keywords": [
    "interview-ai",
    "interview-copilot",
    "ai-interview",
    "groq",
    "whisper",
    "electron",
    "nextjs"
  ],
  "author": "Mohan Krishna Namburu",
  "license": "MIT"
}
